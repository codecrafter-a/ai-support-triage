{
  "name": "ai-support-triage",
  "version": "1.0.0",
  "description": "AI-Powered Support Triage System with RAG and Moderation",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd web && npm run dev",
    "build": "cd web && npm run build",
    "start": "cd server && npm start",
    "seed": "cd server && npm run seed",
    "test": "cd server && npm test",
    "install:all": "npm install && cd server && npm install && cd ../web && npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "openai": "^4.20.1",
    "better-sqlite3": "^9.2.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "axios": "^1.6.2"
  }
}

